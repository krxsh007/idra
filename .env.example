# --- app ---
APP_ENV=development                 # development | test | production
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- database ---
DATABASE_URL=postgresql+asyncpg://idra:idra@localhost:5432/idra
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5

# --- auth ---
JWT_SECRET=change_me_32_bytes_minimum_secret_key_idra_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_secure_password_123

# --- llm ---
LLM_BACKEND=fake                  # gemini | ollama | fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite     # free tier: fastest and most available
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash   # tried in order when the primary is overloaded/out of quota
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_S=25
LLM_MAX_RETRIES=2                 # retries on 429/5xx from the provider
LLM_ATTEMPT_TIMEOUT_S=12             # per model attempt; a hung request moves to the next model
LLM_TEMPERATURE_REASONING=0.2
LLM_TEMPERATURE_PROSE=0.4

# --- rag ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RAG_TOP_K=8
RAG_TOP_K_CITIZEN=6
RAG_SCORE_FLOOR=0.35
RAG_MAX_CONTEXT_TOKENS=3000
RAG_HYBRID_ENABLED=false
KB_STALE_YEARS=10
SITREP_TTL_HOURS=24

# --- gis ---
STUDY_AREA_BBOX=80.15,12.95,80.30,13.15
ROAD_GRAPH_PATH=artifacts/road_graph.pkl
MAX_SNAP_DISTANCE_M=500
HAZARD_SOFT_PENALTY=25.0
DEFAULT_SHELTER_SEARCH_RADIUS_M=10000
DEFAULT_HOSPITAL_SEARCH_RADIUS_M=15000

# --- orchestration ---
RUN_TOTAL_TIMEOUT_S=180
AGENT_TIMEOUT_ASSESSMENT_S=30
AGENT_TIMEOUT_PLANNING_S=30
AGENT_TIMEOUT_EVACUATION_S=20
AGENT_TIMEOUT_FACILITY_S=10
AGENT_TIMEOUT_RESOURCE_S=20
AGENT_TIMEOUT_SYNTHESIS_S=45
ASSESSMENT_CONFIDENCE_FLOOR=0.5

# --- reliability ---
RATE_LIMIT_PUBLIC_PER_MIN=10
RATE_LIMIT_AUTH_PER_MIN=60
WEATHER_ENABLED=false
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
